# === Required ===
GEMINI_API_KEY=your-api-key-here

# === Model ===
GEMINI_MODEL=gemini-2.0-flash

# === Per-folder crop regions (JSON dict) ===
# Key   = exact folder name (stem) inside INPUT_DIR
# Value = [x, y, width, height]  — pixel coords of the student-ID box to black out
#
# Example:
#   CROP_REGIONS={"10A": [0, 0, 300, 80], "10B": [10, 5, 280, 70]}
CROP_REGIONS={}

# Fallback region used when the folder name is not found in CROP_REGIONS.
# Set to null to skip anonymization for unrecognised folders.
# Example: DEFAULT_CROP_REGION=[0, 0, 300, 80]
DEFAULT_CROP_REGION=null

# === Paths ===
INPUT_DIR=input
OUTPUT_DIR=output

# === Reports ===
# Comma-separated list; supported: csv, json
REPORT_FORMATS=["csv", "json"]

# === Gemini rate limits ===
RPM_LIMIT=15
RPD_LIMIT=1500
